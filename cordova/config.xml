<?xml version='1.0' encoding='utf-8'?>
<widget id="com.floura.app" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0" xmlns:android="http://schemas.android.com/apk/res/android">
    <name>Floura</name>
    <description>
        A sample Apache Cordova application that responds to the deviceready event.
    </description>
    <author email="dev@cordova.apache.org" href="https://cordova.apache.org">
        Apache Cordova Team
    </author>
    <content src="index.html" />
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-intent href="tel:*" />
    <allow-intent href="sms:*" />
    <allow-intent href="mailto:*" />
    <allow-intent href="geo:*" />
    <allow-intent href="whatsapp:*" />
    <preference name="DisallowOverscroll" value="true" />

    <platform name="android">
        <preference name="scheme" value="http" />
        <preference name="hostname" value="localhost" />
        <preference name="AndroidWindowSplashScreenAnimatedIcon" value="res/screen/android/splashscreen.png" />
        <preference name="AndroidWindowSplashScreenBackground" value="#FAF8FF" />
        <edit-config file="app/src/main/AndroidManifest.xml" mode="merge" target="/manifest/application">
            <application android:usesCleartextTraffic="true" />
        </edit-config>
        <icon density="ldpi" src="res/icon/android/icon-mdpi.png" />
        <icon density="mdpi" src="res/icon/android/icon-mdpi.png" foreground="res/icon/android/icon-mdpi-foreground.png" background="res/icon/android/icon-mdpi-background.png" />
        <icon density="hdpi" src="res/icon/android/icon-hdpi.png" foreground="res/icon/android/icon-hdpi-foreground.png" background="res/icon/android/icon-hdpi-background.png" />
        <icon density="xhdpi" src="res/icon/android/icon-xhdpi.png" foreground="res/icon/android/icon-xhdpi-foreground.png" background="res/icon/android/icon-xhdpi-background.png" />
        <icon density="xxhdpi" src="res/icon/android/icon-xxhdpi.png" foreground="res/icon/android/icon-xxhdpi-foreground.png" background="res/icon/android/icon-xxhdpi-background.png" />
        <icon density="xxxhdpi" src="res/icon/android/icon-xxxhdpi.png" foreground="res/icon/android/icon-xxxhdpi-foreground.png" background="res/icon/android/icon-xxxhdpi-background.png" />
    </platform>

    <platform name="ios">
        <icon src="res/icon/ios/icon-20x20@1x.png" width="20" height="20" />
        <icon src="res/icon/ios/icon-20x20@2x.png" width="40" height="40" />
        <icon src="res/icon/ios/icon-20x20@3x.png" width="60" height="60" />
        <icon src="res/icon/ios/icon-29x29@1x.png" width="29" height="29" />
        <icon src="res/icon/ios/icon-29x29@2x.png" width="58" height="58" />
        <icon src="res/icon/ios/icon-29x29@3x.png" width="87" height="87" />
        <icon src="res/icon/ios/icon-40x40@1x.png" width="40" height="40" />
        <icon src="res/icon/ios/icon-40x40@2x.png" width="80" height="80" />
        <icon src="res/icon/ios/icon-40x40@3x.png" width="120" height="120" />
        <icon src="res/icon/ios/icon-60x60@2x.png" width="120" height="120" />
        <icon src="res/icon/ios/icon-60x60@3x.png" width="180" height="180" />
        <icon src="res/icon/ios/icon-76x76@1x.png" width="76" height="76" />
        <icon src="res/icon/ios/icon-76x76@2x.png" width="152" height="152" />
        <icon src="res/icon/ios/icon-83.5x83.5@2x.png" width="167" height="167" />
        <icon src="res/icon/ios/icon-1024.png" width="1024" height="1024" />
    </platform>
</widget>
