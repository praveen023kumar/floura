{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "cordova:create": "npx cordova create cordova com.floura.app Floura",
    "cordova:platform-add": "cd cordova && npx cordova platform add ios android",
    "cordova:copy-assets": "node scripts/copy-to-cordova.cjs",
    "cordova:build": "npm run build && npm run cordova:copy-assets && cd cordova && npx cordova build",
    "cordova:run-android": "cd cordova && npx cordova run android",
    "cordova:run-ios": "cd cordova && npx cordova run ios"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-query": "^5.101.0",
    "@vitejs/plugin-react": "^5.0.4",
    "crypto-js": "^4.2.0",
    "dexie": "^4.4.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.15.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.0",
    "react-select": "^5.10.2",
    "recharts": "^3.10.1",
    "sqlite3": "^5.1.7",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/crypto-js": "^4.2.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "cordova": "^12.0.0",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "optionalDependencies": {
    "@rollup/rollup-darwin-x64": "^4.62.2"
  }
}
